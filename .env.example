# Copy to .env and fill in only the keys you have approved for use.
# A provider is used only when configs/providers.yaml selects it AND its daily cap is above zero.
# Never commit .env. Never paste keys into logs, issues, or chat.

# Speech recognition: Deepgram Flux (also Aura-2 TTS, which is wired but not the live voice)
DEEPGRAM_API_KEY=

# LLM: Groq gpt-oss-20b, optional (stage llm=groq). Not the default live LLM
GROQ_API_KEY=

# Voice: Cartesia, the live TTS, with word timestamps (ADR-015)
CARTESIA_API_KEY=

# LLM: Claude Haiku 5.5, the live LLM (ADR-025). Also the delegate worker's model
ANTHROPIC_API_KEY=

# Spotify developer app for the music demo. Free, needs Premium on the app owner's account.
# Register http://127.0.0.1:8888/callback, then run: uv run python -m bench.spotify_login
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# OpenRouter: document agents and the face's model picker (ADR-040)
OPENROUTER_API_KEY=

# Web search (ME3_TOOL_STAGES=search=tavily)
TAVILY_API_KEY=

# Mac phone bridge (ADR-024). The URL is http://127.0.0.1:8765 on the Mac and
# http://<mac-name>.local:8765 from the Pi. The token is the same on both: openssl rand -hex 16
ME3_PHONE_BRIDGE_URL=
ME3_PHONE_BRIDGE_TOKEN=
