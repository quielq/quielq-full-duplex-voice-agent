# Copy to .env and fill in only the keys you have approved for use.
# A provider is used only when configs/providers.yaml selects it AND its daily cap is above zero.
# Never commit .env. Never paste keys into logs, issues, or chat.

# ASR (Deepgram Flux) and bulk-development TTS (Aura-2), on the new-account free credit
DEEPGRAM_API_KEY=

# LLM: Groq gpt-oss-20b, free tier first
GROQ_API_KEY=

# TTS with word timestamps, for truncation tests and final benchmark runs (Pro plan, needs approval)
CARTESIA_API_KEY=

# LLM quality fallback: Claude Haiku 5.5 (needs approval)
ANTHROPIC_API_KEY=

# Model bake-off (needs approval)
OPENROUTER_API_KEY=
